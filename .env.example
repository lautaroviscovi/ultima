# ---------------------------------------------------------------------------
# Servidor (Fly.io). Se setean con:  fly secrets set CLIENT_ORIGIN=...
# ---------------------------------------------------------------------------

# OBLIGATORIO en produccion. Lista exacta de origenes, separados por coma.
# Nunca '*': con '*' cualquier pagina puede abrir sockets contra el servidor.
CLIENT_ORIGIN=https://uno.vercel.app

PORT=3000
NODE_ENV=production

# Cuanto sobrevive un asiento desconectado antes de marcarse abandonado.
RECONNECT_GRACE_MS=120000

# Cuanto sobrevive una sala sin actividad.
ROOM_TTL_MS=3600000

# Turno. 45s por defecto; con 10 jugadores no conviene bajarlo mucho.
TURN_TIMEOUT_MS=45000

# Margen para que el aviso de apagado llegue antes de cerrar los sockets.
SHUTDOWN_GRACE_MS=3000

# ---------------------------------------------------------------------------
# Cliente (Vercel). OJO: las VITE_* se inlinean en el bundle en build time,
# asi que son PUBLICAS. Nunca poner un secreto aca.
# ---------------------------------------------------------------------------

VITE_SERVER_URL=https://uno-server.fly.dev
