{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uno-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  // nodejs_compat da crypto.getRandomValues para nanoid y poco mas.
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }],
  },

  // SQLite-backed es el UNICO backend disponible en el plan free.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],

  "observability": { "enabled": true },

  "vars": {
    // Lista EXACTA de origenes permitidos, separados por coma.
    //
    // Nunca '*': con '*' cualquier pagina puede abrir sockets contra el
    // servidor. Si algo no conecta, se arregla la lista, no se abre.
    // El localhost queda para desarrollo.
    "CLIENT_ORIGIN": "https://uno-delta-two.vercel.app,https://uno-lautaro-viscovis-projects.vercel.app,http://localhost:5173",
  },
}
